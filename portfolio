<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="Ayush Kumar Singh | Cybersecurity Enthusiast Portfolio"
    >

    <title>Ayush Kumar Singh | Cybersecurity Enthusiast</title>


    <style>

        /* =========================================================
           1. GLOBAL VARIABLES
        ========================================================= */

        :root {

            --bg: #050b14;

            --bg-secondary: #081321;

            --card: #0a1727;

            --card-light: #0e1d30;

            --blue: #168cff;

            --blue-bright: #00bfff;

            --blue-soft: #62c9ff;

            --white: #f4f8fc;

            --text: #d5e3ef;

            --muted: #8da3b7;

            --border: rgba(22, 140, 255, 0.22);

            --border-bright: rgba(22, 140, 255, 0.55);

            --font: "Segoe UI", Arial, sans-serif;

            --mono: Consolas, "Courier New", monospace;

        }


        /* =========================================================
           2. RESET
        ========================================================= */

        * {

            margin: 0;

            padding: 0;

            box-sizing: border-box;

            scroll-behavior: smooth;

        }


        body {

            font-family: var(--font);

            color: var(--white);

            background:

                radial-gradient(
                    circle at 80% 0%,
                    rgba(0, 153, 255, 0.13),
                    transparent 28%
                ),

                radial-gradient(
                    circle at 10% 35%,
                    rgba(0, 98, 255, 0.07),
                    transparent 30%
                ),

                var(--bg);

            line-height: 1.7;

            overflow-x: hidden;

        }


        body::before {

            content: "";

            position: fixed;

            inset: 0;

            z-index: -1;

            pointer-events: none;

            background-image:

                linear-gradient(
                    rgba(22, 140, 255, 0.035) 1px,
                    transparent 1px
                ),

                linear-gradient(
                    90deg,
                    rgba(22, 140, 255, 0.035) 1px,
                    transparent 1px
                );

            background-size: 50px 50px;

        }


        a {

            color: inherit;

            text-decoration: none;

        }


        button,
        input {

            font: inherit;

        }


        .container {

            width: min(1120px, 90%);

            margin: 0 auto;

        }



        /* =========================================================
           3. NAVIGATION
        ========================================================= */

        nav {

            position: fixed;

            top: 0;

            left: 0;

            width: 100%;

            height: 72px;

            z-index: 1000;

            display: flex;

            align-items: center;

            background: rgba(5, 11, 20, 0.88);

            backdrop-filter: blur(16px);

            border-bottom: 1px solid rgba(22, 140, 255, 0.12);

        }


        .nav-inner {

            display: flex;

            align-items: center;

            justify-content: space-between;

            width: 100%;

        }


        .logo {

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 1.15rem;

            font-weight: 800;

            letter-spacing: 2px;

        }


        .logo span {

            color: white;

        }


        .nav-links {

            display: flex;

            align-items: center;

            gap: 25px;

            list-style: none;

        }


        .nav-links a {

            position: relative;

            color: var(--muted);

            font-size: 0.82rem;

            transition: 0.3s ease;

        }


        .nav-links a:hover {

            color: var(--blue-bright);

        }


        .nav-links a.active {

            color: var(--blue-bright);

        }


        .nav-links a.active::after {

            content: "";

            position: absolute;

            left: 0;

            right: 0;

            bottom: -8px;

            height: 2px;

            background: var(--blue-bright);

            box-shadow: 0 0 12px var(--blue);

        }


        .nav-contact {

            padding: 8px 14px;

            border: 1px solid var(--border-bright);

            border-radius: 5px;

            color: var(--blue-soft);

        }



        /* =========================================================
           4. HERO
        ========================================================= */

        .hero {

            min-height: 100vh;

            padding-top: 72px;

            display: flex;

            align-items: center;

        }


        .hero-grid {

            display: grid;

            grid-template-columns: 1.05fr 0.95fr;

            align-items: center;

            gap: 70px;

        }


        .terminal-intro {

            margin-bottom: 18px;

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.78rem;

        }


        .terminal-intro span {

            color: #60788d;

        }


        .hero h1 {

            max-width: 700px;

            margin-bottom: 16px;

            font-size: clamp(3.2rem, 6vw, 5.6rem);

            line-height: 0.98;

            letter-spacing: -3px;

        }


        .hero h1 span {

            color: var(--blue);

            text-shadow: 0 0 30px rgba(22, 140, 255, 0.22);

        }


        .hero h2 {

            margin-bottom: 20px;

            color: #b7d0e4;

            font-size: 1.45rem;

            font-weight: 600;

        }


        .hero-text {

            max-width: 650px;

            margin-bottom: 28px;

            color: var(--muted);

            font-size: 0.98rem;

        }


        .hero-buttons {

            display: flex;

            flex-wrap: wrap;

            gap: 12px;

        }


        .button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            padding: 11px 19px;

            border-radius: 6px;

            border: 1px solid var(--border-bright);

            font-size: 0.84rem;

            font-weight: 600;

            transition: 0.3s ease;

        }


        .button-primary {

            color: white;

            background: linear-gradient(
                135deg,
                #0876df,
                #10b7ff
            );

            border-color: transparent;

            box-shadow: 0 10px 28px rgba(22, 140, 255, 0.18);

        }


        .button-primary:hover {

            transform: translateY(-3px);

            box-shadow: 0 14px 35px rgba(22, 140, 255, 0.3);

        }


        .button-outline {

            color: var(--blue-soft);

        }


        .button-outline:hover {

            background: rgba(22, 140, 255, 0.08);

            transform: translateY(-3px);

        }


        .socials {

            display: flex;

            gap: 9px;

            margin-top: 20px;

        }


        .socials a {

            width: 39px;

            height: 39px;

            display: grid;

            place-items: center;

            border: 1px solid var(--border);

            border-radius: 6px;

            color: var(--muted);

            font-family: var(--mono);

            font-size: 0.72rem;

            transition: 0.3s ease;

        }


        .socials a:hover {

            color: var(--blue-bright);

            border-color: var(--border-bright);

            transform: translateY(-3px);

        }



        /* =========================================================
           5. PROFILE PHOTO AREA
        ========================================================= */

        .profile-area {

            display: flex;

            justify-content: center;

            position: relative;

        }


        .profile-frame {

            position: relative;

            width: 350px;

            height: 420px;

            padding: 18px;

            background: rgba(5, 20, 36, 0.8);

            border: 1px solid var(--border-bright);

            clip-path: polygon(
                7% 0,
                93% 0,
                100% 7%,
                100% 93%,
                93% 100%,
                7% 100%,
                0 93%,
                0 7%
            );

            box-shadow:

                0 0 50px rgba(0, 153, 255, 0.08),

                inset 0 0 45px rgba(0, 153, 255, 0.04);

        }


        .profile-frame::before {

            content: "";

            position: absolute;

            top: 0;

            left: 0;

            width: 80px;

            height: 80px;

            border-top: 2px solid var(--blue-bright);

            border-left: 2px solid var(--blue-bright);

        }


        .profile-frame::after {

            content: "";

            position: absolute;

            right: 0;

            bottom: 0;

            width: 80px;

            height: 80px;

            border-right: 2px solid var(--blue-bright);

            border-bottom: 2px solid var(--blue-bright);

        }


        .photo-box {

            width: 100%;

            height: 100%;

            position: relative;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            overflow: hidden;

            border: 1px solid rgba(0, 191, 255, 0.25);

            background:

                radial-gradient(
                    circle,
                    rgba(0, 140, 255, 0.16),
                    rgba(3, 12, 24, 0.95) 68%
                );

        }


        .photo-box img {

            display: none;

            width: 100%;

            height: 100%;

            object-fit: cover;

        }


        .photo-placeholder {

            text-align: center;

            color: var(--muted);

            padding: 25px;

        }


        .photo-icon {

            width: 85px;

            height: 85px;

            margin: 0 auto 17px;

            display: grid;

            place-items: center;

            border: 1px solid var(--border-bright);

            border-radius: 50%;

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 1.6rem;

        }


        .photo-placeholder strong {

            display: block;

            margin-bottom: 5px;

            color: white;

        }


        .photo-placeholder p {

            margin-bottom: 15px;

            font-size: 0.72rem;

        }


        .upload-button {

            display: inline-block;

            padding: 7px 12px;

            cursor: pointer;

            border: 1px solid var(--border-bright);

            border-radius: 4px;

            color: var(--blue-soft);

            font-family: var(--mono);

            font-size: 0.7rem;

        }


        #photoInput {

            display: none;

        }


        .profile-label {

            position: absolute;

            bottom: 28px;

            left: 50%;

            transform: translateX(-50%);

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.65rem;

            letter-spacing: 2px;

            white-space: nowrap;

        }


        .status-box {

            position: absolute;

            right: -25px;

            top: 50px;

            width: 165px;

            padding: 15px;

            background: rgba(4, 15, 28, 0.95);

            border: 1px solid var(--border);

            border-radius: 6px;

            font-family: var(--mono);

            font-size: 0.68rem;

        }


        .status-box small {

            color: #59738a;

        }


        .status-box strong {

            display: block;

            margin: 5px 0;

            color: white;

            font-family: var(--font);

            font-size: 0.77rem;

        }


        .status-dot {

            display: inline-block;

            width: 7px;

            height: 7px;

            margin-right: 5px;

            border-radius: 50%;

            background: #00e68a;

            box-shadow: 0 0 10px #00e68a;

        }



        /* =========================================================
           6. SECTION COMMON STYLES
        ========================================================= */

        section {

            padding: 100px 0;

        }


        .section-title {

            margin-bottom: 42px;

        }


        .section-number {

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.75rem;

        }


        .section-title h2 {

            margin-top: 3px;

            font-size: 2.2rem;

            letter-spacing: -0.5px;

        }


        .section-title h2::after {

            content: "";

            display: block;

            width: 55px;

            height: 3px;

            margin-top: 11px;

            background: var(--blue);

            box-shadow: 0 0 12px rgba(22, 140, 255, 0.65);

        }



        /* =========================================================
           7. ABOUT
        ========================================================= */

        .about-grid {

            display: grid;

            grid-template-columns: 1.15fr 0.85fr;

            gap: 55px;

            align-items: center;

        }


        .about-content p {

            margin-bottom: 16px;

            color: var(--muted);

            font-size: 0.94rem;

        }


        .about-highlights {

            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 12px;

        }


        .highlight-card {

            padding: 22px;

            border: 1px solid var(--border);

            border-radius: 7px;

            background: rgba(8, 25, 43, 0.7);

            transition: 0.3s ease;

        }


        .highlight-card:hover {

            transform: translateY(-4px);

            border-color: var(--border-bright);

        }


        .highlight-number {

            margin-bottom: 3px;

            color: var(--blue-bright);

            font-size: 1.55rem;

            font-weight: 800;

        }


        .highlight-card p {

            margin: 0;

            color: var(--muted);

            font-size: 0.76rem;

        }



        /* =========================================================
           8. SKILLS
        ========================================================= */

        .skill-groups {

            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 18px;

        }


        .skill-group {

            padding: 24px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: rgba(8, 25, 43, 0.68);

        }


        .skill-group h3 {

            margin-bottom: 15px;

            color: var(--blue-soft);

            font-size: 1rem;

        }


        .skill-list {

            display: flex;

            flex-wrap: wrap;

            gap: 8px;

        }


        .skill {

            padding: 7px 11px;

            border: 1px solid rgba(22, 140, 255, 0.2);

            border-radius: 4px;

            color: #ccecff;

            background: rgba(22, 140, 255, 0.05);

            font-family: var(--mono);

            font-size: 0.72rem;

        }



        /* =========================================================
           9. PROJECTS
        ========================================================= */

        .project-grid {

            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 20px;

        }


        .project-card {

            padding: 28px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background:

                linear-gradient(
                    145deg,
                    rgba(10, 32, 54, 0.9),
                    rgba(4, 15, 28, 0.95)
                );

            transition: 0.35s ease;

        }


        .project-card:hover {

            transform: translateY(-6px);

            border-color: var(--border-bright);

            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);

        }


        .project-top {

            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 15px;

            margin-bottom: 17px;

        }


        .project-icon {

            width: 48px;

            height: 48px;

            display: grid;

            place-items: center;

            border: 1px solid var(--border-bright);

            border-radius: 7px;

            color: var(--blue-bright);

            font-size: 1.25rem;

        }


        .project-type {

            padding: 4px 8px;

            border: 1px solid var(--border);

            border-radius: 4px;

            color: var(--blue-soft);

            font-family: var(--mono);

            font-size: 0.65rem;

        }


        .project-card h3 {

            margin-bottom: 9px;

            font-size: 1.17rem;

        }


        .project-card p {

            margin-bottom: 17px;

            color: var(--muted);

            font-size: 0.84rem;

        }


        .project-points {

            margin: 0 0 19px 18px;

            color: #9fb5c7;

            font-size: 0.78rem;

        }


        .project-points li {

            margin-bottom: 5px;

        }


        .tech-tags {

            display: flex;

            flex-wrap: wrap;

            gap: 6px;

            margin-bottom: 18px;

        }


        .tech-tag {

            padding: 4px 8px;

            border-radius: 3px;

            background: rgba(22, 140, 255, 0.08);

            color: #7fd4ff;

            font-family: var(--mono);

            font-size: 0.63rem;

        }


        .project-link {

            color: var(--blue-bright);

            font-size: 0.78rem;

            font-weight: 600;

        }



        /* =========================================================
           10. EDUCATION
        ========================================================= */

        .education-card {

            display: grid;

            grid-template-columns: 1fr auto;

            gap: 30px;

            align-items: center;

            padding: 30px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: rgba(8, 25, 43, 0.7);

        }


        .education-card h3 {

            margin-bottom: 6px;

            color: var(--blue-soft);

            font-size: 1.2rem;

        }


        .education-card p {

            color: var(--muted);

            font-size: 0.86rem;

        }


        .education-year {

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.75rem;

        }



        /* =========================================================
           11. TRAINING
        ========================================================= */

        .training-card {

            margin-top: 18px;

            padding: 25px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: rgba(8, 25, 43, 0.7);

        }


        .training-card h3 {

            color: var(--blue-soft);

            font-size: 1rem;

        }


        .training-card .training-meta {

            margin: 4px 0 12px;

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.7rem;

        }


        .training-card ul {

            margin-left: 18px;

            color: var(--muted);

            font-size: 0.8rem;

        }


        .training-card li {

            margin-bottom: 5px;

        }



        /* =========================================================
           12. CERTIFICATIONS / ACHIEVEMENTS
        ========================================================= */

        .certificate-grid {

            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 15px;

        }


        .certificate-card {

            display: flex;

            align-items: flex-start;

            gap: 16px;

            padding: 21px;

            border: 1px solid var(--border);

            border-radius: 8px;

            background: rgba(8, 25, 43, 0.7);

            transition: 0.3s ease;

        }


        .certificate-card:hover {

            transform: translateY(-4px);

            border-color: var(--border-bright);

        }


        .certificate-icon {

            flex-shrink: 0;

            width: 42px;

            height: 42px;

            display: grid;

            place-items: center;

            border: 1px solid var(--border-bright);

            border-radius: 6px;

            color: var(--blue-bright);

        }


        .certificate-card h3 {

            margin-bottom: 3px;

            font-size: 0.95rem;

        }


        .certificate-card p {

            color: var(--muted);

            font-size: 0.75rem;

        }


        .certificate-date {

            margin-top: 4px;

            color: #6e879b !important;

            font-family: var(--mono);

            font-size: 0.64rem !important;

        }



        /* =========================================================
           13. CONTACT
        ========================================================= */

        .contact-card {

            display: grid;

            grid-template-columns: 1fr auto;

            align-items: center;

            gap: 35px;

            padding: 40px;

            border: 1px solid var(--border);

            border-radius: 9px;

            background:

                linear-gradient(
                    135deg,
                    rgba(8, 31, 53, 0.9),
                    rgba(4, 14, 26, 0.96)
                );

        }


        .contact-card h3 {

            margin-bottom: 7px;

            font-size: 1.35rem;

        }


        .contact-card p {

            max-width: 650px;

            color: var(--muted);

            font-size: 0.86rem;

        }


        .contact-email {

            display: inline-block;

            margin-top: 13px;

            color: var(--blue-bright);

            font-family: var(--mono);

            font-size: 0.78rem;

        }


        .contact-buttons {

            display: flex;

            flex-wrap: wrap;

            gap: 9px;

        }



        /* =========================================================
           14. FOOTER
        ========================================================= */

        footer {

            padding: 25px 0;

            border-top: 1px solid rgba(22, 140, 255, 0.1);

            color: #6d8397;

            font-size: 0.7rem;

        }


        .footer-inner {

            display: flex;

            justify-content: space-between;

            gap: 20px;

        }


        footer span {

            color: var(--blue-soft);

        }



        /* =========================================================
           15. SCROLL ANIMATION
        ========================================================= */

        .reveal {

            opacity: 0;

            transform: translateY(25px);

            transition:

                opacity 0.7s ease,

                transform 0.7s ease;

        }


        .reveal.visible {

            opacity: 1;

            transform: translateY(0);

        }



        /* =========================================================
           16. RESPONSIVE DESIGN
        ========================================================= */

        @media (max-width: 950px) {

            .nav-links {

                display: none;

            }


            .hero-grid {

                grid-template-columns: 1fr;

                gap: 35px;

            }


            .profile-area {

                order: -1;

            }


            .about-grid {

                grid-template-columns: 1fr;

            }


            .skill-groups {

                grid-template-columns: 1fr 1fr;

            }


            .contact-card {

                grid-template-columns: 1fr;

            }

        }


        @media (max-width: 650px) {

            section {

                padding: 75px 0;

            }


            .hero h1 {

                font-size: 3.2rem;

                letter-spacing: -2px;

            }


            .profile-frame {

                width: 300px;

                height: 370px;

            }


            .status-box {

                right: 0;

            }


            .project-grid,

            .certificate-grid,

            .skill-groups {

                grid-template-columns: 1fr;

            }


            .education-card {

                grid-template-columns: 1fr;

            }


            .contact-card {

                padding: 28px;

            }


            .footer-inner {

                flex-direction: column;

            }

        }

    

        /* FINAL PORTFOLIO POLISH: circular profile portrait */
        .profile-area {
            align-items: center;
        }

        .profile-frame {
            width: 390px;
            height: 390px;
            padding: 14px;
            border-radius: 50%;
            clip-path: none;
            background: radial-gradient(circle at center, rgba(8, 118, 223, 0.16), rgba(5, 20, 36, 0.86) 68%);
            border: 2px solid var(--blue-bright);
            box-shadow: 0 0 0 8px rgba(22, 140, 255, 0.06), 0 0 55px rgba(0, 153, 255, 0.22), inset 0 0 40px rgba(0, 153, 255, 0.08);
        }

        .profile-frame::before,
        .profile-frame::after {
            display: none;
        }

        .photo-box {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid rgba(22, 140, 255, 0.75);
            background: #06111f;
        }

        .photo-box img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center center;
        }

        .profile-label {
            display: none;
        }

        @media (max-width: 900px) {
            .profile-frame {
                width: 310px;
                height: 310px;
            }
        }

        @media (max-width: 520px) {
            .profile-frame {
                width: 260px;
                height: 260px;
            }
        }

    
        /* =========================================================
           CERTIFICATE GALLERY
        ========================================================== */

        .section-intro {
            max-width: 760px;
            margin: -8px 0 36px;
            color: var(--muted);
            line-height: 1.8;
        }

        .certificate-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 28px;
        }

        .certificate-card {
            overflow: hidden;
            border: 1px solid rgba(0, 153, 255, 0.24);
            border-radius: 18px;
            background: linear-gradient(
                145deg,
                rgba(8, 27, 51, 0.92),
                rgba(3, 14, 29, 0.96)
            );
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.28);
            transition:
                transform 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
        }

        .certificate-card:hover {
